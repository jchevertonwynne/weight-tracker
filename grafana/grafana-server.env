# Grafana settings for the weight tracker, appended to
# /etc/default/grafana-server by `make deploy-grafana`.
#
# Environment overrides rather than edits to grafana.ini: they survive a
# package upgrade rewriting the ini, and they are idempotent to reapply.
# Grafana maps GF_<SECTION>_<KEY> onto the corresponding ini setting.

# Bind to loopback only. The app reverse-proxies /grafana/ to here, so this
# is reachable through the app and nowhere else — no second open port.
GF_SERVER_HTTP_ADDR=127.0.0.1
GF_SERVER_HTTP_PORT=3000

# Served under the app's origin at /grafana/, so every asset URL Grafana
# generates is a same-origin absolute path. That keeps the embed working
# whether the app is reached as jcwpi, a Tailscale address, or localhost.
GF_SERVER_ROOT_URL=http://localhost:8090/grafana/
GF_SERVER_SERVE_FROM_SUB_PATH=true

# Required for the <iframe>: without it Grafana sends X-Frame-Options: deny.
GF_SECURITY_ALLOW_EMBEDDING=true

# The panel has to render without a login. Viewer is read-only, and Grafana
# is only reachable through the app, which has no auth of its own — so this
# grants nothing that reaching the app did not already grant. Editing
# dashboards still requires signing in as admin.
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
GF_AUTH_BASIC_ENABLED=true

# It is a Raspberry Pi on a home network; no phoning home.
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_NEWS_NEWS_FEED_ENABLED=false
